{
  "version": 2,
  "rules": [
    {
      "id": "R-110",
      "name": "Aanval vanaf een IP-adres",
      "enabled": true,
      "priority": 200,
      "when": {
        "sources": ["cs2.demo", "aws.guardduty"],
        "detail_types": ["CS2 Security Finding"],
        "min_severity": "medium",
        "title_contains": ["attack", "scan", "brute", "firewall", "recon"],
        "has_source_ip": true
      },
      "then": ["block_ip", "notify"]
    },
    {
      "id": "SOAR-003",
      "name": "Malware of command-and-control",
      "enabled": true,
      "priority": 180,
      "when": {
        "sources": ["cs2.demo", "aws.guardduty"],
        "detail_types": ["CS2 Security Finding"],
        "min_severity": "medium",
        "title_contains": ["malware", "ransom", "c2", "beacon", "command and control"]
      },
      "then": ["quarantine", "notify"]
    },
    {
      "id": "R-120",
      "name": "Misbruik van rechten (privilege-escalatie)",
      "enabled": true,
      "priority": 150,
      "when": {
        "sources": ["cs2.demo", "aws.guardduty"],
        "detail_types": ["CS2 Security Finding"],
        "min_severity": "critical",
        "title_contains": ["privilege", "sudo", "escalat"]
      },
      "then": ["notify"]
    },
    {
      "id": "SOAR-005",
      "name": "Platformalarm (SOAR of load balancer)",
      "enabled": true,
      "priority": 120,
      "when": {
        "sources": ["aws.cloudwatch"],
        "detail_types": ["CloudWatch Alarm State Change"],
        "min_severity": "medium",
        "title_contains": ["5xx", "unhealthy", "soar", "dlq", "no-data"]
      },
      "then": ["notify"]
    },
    {
      "id": "R-100",
      "name": "Veel mislukte logins",
      "enabled": true,
      "priority": 100,
      "when": {
        "sources": ["cs2.demo", "aws.guardduty"],
        "detail_types": ["CS2 Security Finding"],
        "min_severity": "high",
        "title_contains": ["login", "auth", "credential"],
        "has_source_ip": true
      },
      "then": ["notify"]
    },
    {
      "id": "SOAR-001",
      "name": "Hoge CPU-belasting",
      "enabled": true,
      "priority": 50,
      "when": {
        "sources": ["aws.cloudwatch"],
        "detail_types": ["CloudWatch Alarm State Change"],
        "min_severity": "medium",
        "title_contains": ["cpu"]
      },
      "then": ["notify"]
    },
    {
      "id": "SOAR-006",
      "name": "Kritieke bevinding: altijd melden",
      "enabled": true,
      "priority": 10,
      "when": {
        "min_severity": "critical"
      },
      "then": ["notify"]
    }
  ]
}
