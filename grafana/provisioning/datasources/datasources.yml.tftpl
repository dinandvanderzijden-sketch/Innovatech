apiVersion: 1

datasources:
  - name: AMP
    type: prometheus
    uid: amp
    access: proxy
    url: ${amp_url}
    isDefault: true
    jsonData:
      httpMethod: POST
      sigV4Auth: true
      sigV4AuthType: default
      sigV4Region: ${region}
      timeInterval: 30s

  - name: Loki
    type: loki
    uid: loki
    access: proxy
    url: http://loki.innovatech.internal:3100
    jsonData:
      maxLines: 1000

  - name: CloudWatch
    type: cloudwatch
    uid: cloudwatch
    access: proxy
    jsonData:
      authType: default
      defaultRegion: ${region}
